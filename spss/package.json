{
  "name": "spss-monitorizare-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node --env-file=.env dist/server/server/main.js",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "admin": "node --env-file=.env scripts/admin.mjs",
    "backup": "node --env-file=.env scripts/backup.mjs",
    "import": "node --env-file=.env scripts/import.mjs"
  },
  "dependencies": {
    "zod": "3.25.76",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "@vitejs/plugin-react": "6.0.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
