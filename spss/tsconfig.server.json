{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist/server",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "server",
    "lib/server-*.ts",
    "lib/config.ts",
    "lib/model.ts",
    "data/catalog.json"
  ]
}